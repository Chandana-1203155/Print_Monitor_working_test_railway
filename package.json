{
  "name": "secure-print-monitor",
  "version": "1.0.1",
  "description": "Secure Role-Based Print Monitoring System",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && concurrently \"node backend/server.js\" \"electron .\"",
    "backend": "node backend/server.js",
    "test": "jest",
    "dist": "electron-builder",
    "build:client": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:publish": "electron-builder --publish=never"
  },
  "build": {
    "appId": "com.secureprint.app",
    "productName": "SecurePrint",
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/**/*",
      "electron/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!**/node_modules/{axios,bcryptjs,cors,dotenv,express,express-rate-limit,helmet,jsonwebtoken,multer,mysql2,nodemailer,sequelize,sequelize-pool,xlsx}/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": "x64" },
        { "target": "msi", "arch": "x64" },
        { "target": "portable", "arch": "x64" }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": "x64" },
        { "target": "pkg", "arch": "x64" }
      ]
    },
    "linux": {
      "target": [
        { "target": "deb", "arch": "x64" },
        { "target": "AppImage", "arch": "x64" }
      ]
    },
    "nsis": {
      "artifactName": "SecurePrintClient-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SecurePrint",
      "include": "electron/installer.nsh",
      "installerSidebar": null,
      "license": null
    },
    "msi": {
      "artifactName": "SecurePrintClient-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "SecurePrintClient-${version}.${ext}"
    },
    "pkg": {
      "artifactName": "SecurePrintClient-${version}-Installer.${ext}"
    },
    "deb": {
      "artifactName": "secureprintclient_${version}_amd64.${ext}"
    },
    "appImage": {
      "artifactName": "SecurePrintClient-${version}.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.8",
    "pdf-parse": "^1.1.1",
    "pdf-to-printer": "^5.0.1",
    "pdfkit": "^0.14.0",
    "sequelize": "^6.35.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^25.0.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  }
}
